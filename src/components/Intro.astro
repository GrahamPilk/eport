---
// Load-in: an ordered-dither "develop" wave. ~1.4s, once per session, home only.
// Tap / click / any key skips. prefers-reduced-motion and no-JS never see it.
import { SITE } from '../site.config.mjs';
const year = new Date().getFullYear();
---
<div id="intro" aria-hidden="true" data-name={SITE.name} data-sub={`${SITE.role} — ${year}`}>
  <canvas></canvas>
  <button type="button" class="intro-skip px" tabindex="-1">Skip ›</button>
</div>
<style is:global>
  #intro { display: none; }
  html.intro, html.intro body { overflow: hidden; }
  html.intro #intro {
    display: block; position: fixed; inset: 0; z-index: 100; background: var(--ink);
    animation: intro-failsafe 0s 4.5s forwards; touch-action: none; cursor: pointer;
  }
  #intro canvas { width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }
  .intro-skip {
    position: absolute; right: var(--gutter); bottom: max(var(--gutter), env(safe-area-inset-bottom));
    background: none; border: 0; padding: 12px; color: #fff; mix-blend-mode: difference; cursor: pointer;
  }
  @keyframes intro-failsafe { to { visibility: hidden; pointer-events: none; } }
</style>
<script is:inline>
(() => {
  const root = document.documentElement, el = document.getElementById('intro');
  if (!el) return;
  if (!root.classList.contains('intro')) { el.remove(); return; }

  // 8x8 Bayer matrix, values 0..63
  const B = [0,32,8,40,2,34,10,42,48,16,56,24,50,18,58,26,12,44,4,36,14,46,6,38,60,28,52,20,62,30,54,22,
             3,35,11,43,1,33,9,41,51,19,59,27,49,17,57,25,15,47,7,39,13,45,5,37,63,31,55,23,61,29,53,21].map(v => (v + 0.5) / 64);
  const css = getComputedStyle(root);
  const pack = (c) => { const n = parseInt(c.trim().replace('#','').replace(/^(.)(.)(.)$/,'$1$1$2$2$3$3'), 16); return (255 << 24 | (n & 255) << 16 | (n >> 8 & 255) << 8 | n >> 16) >>> 0; };
  const INK = pack(css.getPropertyValue('--ink') || '#000'), PAPER = pack(css.getPropertyValue('--paper') || '#fff');
  const coarse = matchMedia('(pointer: coarse)').matches;
  const cv = el.querySelector('canvas'), ctx = cv.getContext('2d');
  const T1 = 760, T2 = 1060, T3 = 1500, SKIP = 240;   // wave · hold · dissolve
  let cols, rows, img, px, mask, dist, maxR, t0 = 0, skipAt = 0, frozen = 0, done = false;

  function layout() {
    const cell = innerWidth < 640 ? 4 : 5;
    cols = Math.ceil(innerWidth / cell); rows = Math.ceil(innerHeight / cell);
    cv.width = cols; cv.height = rows;
    img = ctx.createImageData(cols, rows); px = new Uint32Array(img.data.buffer);
    // origin: bottom-centre on phones (where the card meets the screen), centre on desktop
    const ox = cols / 2, oy = coarse ? rows * 0.9 : rows / 2;
    maxR = Math.hypot(Math.max(ox, cols - ox), Math.max(oy, rows - oy));
    dist = new Float32Array(cols * rows);
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) dist[y * cols + x] = Math.hypot(x - ox, (y - oy) * 1.05);
    // rasterise the name at cell resolution (pixel font at multiples of 8 stays crisp)
    const o = document.createElement('canvas'); o.width = cols; o.height = rows;
    const c = o.getContext('2d'), name = el.dataset.name.toUpperCase(), sub = el.dataset.sub.toUpperCase();
    c.font = '8px Silkscreen, monospace';
    const w8 = c.measureText(name).width || name.length * 6;
    const fs = Math.max(8, Math.min(Math.floor((cols * 0.84) / w8) * 8, Math.floor(rows * 0.16 / 8) * 8));
    c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillStyle = '#000';
    c.font = fs + 'px Silkscreen, monospace'; c.fillText(name, cols / 2, rows * 0.46);
    c.font = '8px Silkscreen, monospace';
    // the subline only renders if it fits (8 cells is the smallest crisp size); otherwise fall back to the year
    const line = [sub, sub.split(' — ').pop()].find((s) => c.measureText(s).width < cols * 0.9);
    if (line) c.fillText(line, cols / 2, rows * 0.46 + fs * 0.62 + 6);
    const a = c.getImageData(0, 0, cols, rows).data;
    mask = new Uint8Array(cols * rows);
    for (let i = 0; i < mask.length; i++) mask[i] = a[i * 4 + 3] > 110 ? 1 : 0;
  }

  const ease = (x) => 1 - Math.pow(1 - Math.min(1, Math.max(0, x)), 3);

  function frame(now) {
    if (done) return;
    if (!t0) t0 = now;
    const t = now - t0;
    // dissolve progress: normal timeline, or a fast one after a skip
    const p = skipAt ? (now - skipAt) / SKIP : (t - T2) / (T3 - T2);
    const tb = skipAt ? frozen : Math.min(t, T2);
    if (p > -0.15) root.classList.add('reveal'); // page content starts arriving under the dissolve
    const R = ease(tb / T1) * maxR * 1.3, band = maxR * 0.3;
    // brief horizontal glitch on the name during the hold
    const g = !skipAt && ((t > 720 && t < 770) || (t > 860 && t < 885));
    for (let y = 0; y < rows; y++) {
      const shift = g && ((y * 7 + (t | 0)) % 11 < 3) ? ((y % 3) - 1) * 3 : 0;
      for (let x = 0; x < cols; x++) {
        const i = y * cols + x, b = B[(y & 7) * 8 + (x & 7)], d = dist[i] / maxR;
        let mx = x - shift; mx = mx < 0 ? 0 : mx >= cols ? cols - 1 : mx;
        const m = mask[y * cols + mx];
        if (p > 0 && p * 1.7 - (1 - d) * 0.7 - (m ? 0.25 : 0) > b) { px[i] = 0; continue; }
        const lit = (R - dist[i]) / band > b;
        px[i] = lit && !m ? PAPER : INK;
      }
    }
    ctx.putImageData(img, 0, 0);
    if (p >= 1) return finish();
    requestAnimationFrame(frame);
  }

  function finish() {
    if (done) return; done = true;
    try { sessionStorage.setItem('intro', '1'); } catch (e) {}
    root.classList.remove('intro'); root.classList.add('reveal');
    el.remove();
    removeEventListener('keydown', skip); removeEventListener('wheel', skip);
  }
  function skip() {
    if (skipAt || done) return;
    frozen = Math.min(performance.now() - t0, T2); skipAt = performance.now();
  }
  el.addEventListener('pointerdown', skip);
  addEventListener('keydown', skip); addEventListener('wheel', skip, { passive: true });
  setTimeout(finish, 4000);

  const go = () => { layout(); requestAnimationFrame(frame); };
  const font = document.fonts && document.fonts.load ? document.fonts.load('8px Silkscreen') : Promise.resolve();
  Promise.race([font, new Promise((r) => setTimeout(r, 350))]).then(go, go);
})();
</script>
