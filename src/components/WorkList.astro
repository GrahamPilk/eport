---
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'work'>[]; }
const { items } = Astro.props;
---
<ol class="rows" role="list">
  {items.map((w, i) => (
    <li>
      <a href={`/work/${w.id}`} class="row">
        <span class="px idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="main">
          <span class="t">{w.data.title}</span>
          <span class="s">{w.data.summary}</span>
        </span>
        <span class="px meta">{w.data.role}<br />{w.data.year}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ol>
<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .rows li { border-bottom: 1px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: 3rem 1fr 11rem 2rem; gap: calc(var(--u) * 2); align-items: start;
    padding: calc(var(--u) * 2.5) var(--u); text-decoration: none;
  }
  .t { display: block; font-size: var(--step-1); font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; }
  .s { display: block; margin-top: 4px; max-width: 52ch; }
  .idx, .meta { padding-top: 0.35em; }
  .arrow { font-size: var(--step-1); justify-self: end; line-height: 1.25; }
  /* 1-bit hover: hard invert, no easing */
  .row:hover, .row:focus-visible { background: var(--ink); color: var(--paper); outline: none; }
  .row:hover .arrow { transform: translateX(4px); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 2.25rem 1fr 1.5rem; }
    .meta { grid-column: 2; grid-row: 2; padding-top: 0; }
    .arrow { grid-column: 3; grid-row: 1; }
  }
</style>
