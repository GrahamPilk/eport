---
// A 1-bit, ordered-dithered planet. Light follows the pointer / finger,
// idles in a slow orbit, pauses off-screen, renders one still frame for reduced motion.
interface Props { label?: string; }
const { label = 'Animated dithered sphere' } = Astro.props;
---
<figure class="field">
  <canvas width="160" height="160" role="img" aria-label={label}></canvas>
  <figcaption class="px" aria-hidden="true"><span data-lx>L 0.00</span><span>8×8 BAYER</span></figcaption>
</figure>

<style>
  .field { margin: 0; position: relative; aspect-ratio: 1; width: 100%; max-width: 440px; justify-self: end; }
  canvas { width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; touch-action: pan-y; }
  figcaption { display: flex; justify-content: space-between; margin-top: 8px; }
  @media (max-width: 760px) { .field { max-width: 320px; justify-self: start; } }
</style>

<script>
  const B = [0,32,8,40,2,34,10,42,48,16,56,24,50,18,58,26,12,44,4,36,14,46,6,38,60,28,52,20,62,30,54,22,
    3,35,11,43,1,33,9,41,51,19,59,27,49,17,57,25,15,47,7,39,13,45,5,37,63,31,55,23,61,29,53,21].map((v) => (v + 0.5) / 64);

  for (const cv of document.querySelectorAll<HTMLCanvasElement>('.field canvas')) {
    const ctx = cv.getContext('2d')!;
    const N = cv.width, img = ctx.createImageData(N, N), px = new Uint32Array(img.data.buffer);
    const label = cv.parentElement!.querySelector<HTMLElement>('[data-lx]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ink = 0, paper = 0;
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      const p = (c: string) => { const n = parseInt(c.trim().replace('#', '').replace(/^(.)(.)(.)$/, '$1$1$2$2$3$3'), 16); return (255 << 24 | (n & 255) << 16 | (n >> 8 & 255) << 8 | n >> 16) >>> 0; };
      ink = p(s.getPropertyValue('--ink')); paper = p(s.getPropertyValue('--paper'));
    };
    readColors();

    // light direction target (from pointer) and current (eased)
    let tx = -0.55, ty = -0.6, lx = tx, ly = ty, user = 0, visible = true, raf = 0;
    const R = N * 0.36, cx = N / 2, cy = N * 0.46;

    function draw(t: number) {
      if (performance.now() - user > 2500 && !reduce) { tx = Math.cos(t / 2200) * 0.75; ty = -0.35 + Math.sin(t / 3100) * 0.45; }
      lx += (tx - lx) * 0.08; ly += (ty - ly) * 0.08;
      const lz = Math.sqrt(Math.max(0.05, 1 - lx * lx - ly * ly));
      const rot = reduce ? 0.6 : t / 2600;
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const i = y * N + x, b = B[(y & 7) * 8 + (x & 7)];
          const nx = (x - cx) / R, ny = (y - cy) / R, r2 = nx * nx + ny * ny;
          let v: number;
          if (r2 <= 1) {
            const nz = Math.sqrt(1 - r2);
            let l = Math.max(0, nx * lx + ny * ly + nz * lz);
            // latitude bands, rotating longitude stripes = reads as a turning globe
            const lon = Math.atan2(nx, nz) + rot, lat = Math.asin(ny);
            const band = (Math.sin(lon * 4) > 0.7 ? 0.8 : 1) * (Math.abs(lat) < 0.035 || Math.abs(Math.abs(lat) - 0.62) < 0.025 ? 0.45 : 1);
            v = 0.04 + Math.pow(l, 1.25) * 0.98 * band;
            px[i] = v > b ? paper : ink;
          } else {
            // cast shadow on the "floor": dithered ellipse that slides opposite the light
            const sx = (x - cx + lx * R * 0.5) / (R * 1.05), sy = (y - (cy + R * 1.22)) / (R * 0.18);
            const s = 1 - (sx * sx + sy * sy);
            v = 1 - Math.max(0, s) * 0.85;
            px[i] = v > b ? paper : ink;
          }
        }
      }
      ctx.putImageData(img, 0, 0);
      if (label) label.textContent = `L ${lx.toFixed(2)} ${ly.toFixed(2)}`;
      if (!reduce && visible) raf = requestAnimationFrame(draw);
    }

    const aim = (e: PointerEvent) => {
      const r = cv.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width - 0.5) * 2.4));
      ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height - 0.46) * 2.4));
      user = performance.now();
    };
    addEventListener('pointermove', aim, { passive: true });
    cv.addEventListener('pointerdown', aim);
    addEventListener('themechange', () => { readColors(); if (reduce) draw(0); });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readColors(); if (reduce) draw(0); });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) raf = requestAnimationFrame(draw);
    }).observe(cv);
    draw(0);
  }
</script>
