---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---
<ol class="posts" role="list">
  {posts.map((p) => (
    <li>
      <a href={`/blog/${p.id}`}>
        <time class="px" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        <span class="t">{p.data.title}</span>
        {p.data.description && <span class="d">{p.data.description}</span>}
      </a>
    </li>
  ))}
</ol>
<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li + li { border-top: 1px dashed var(--ink); }
  a { display: grid; grid-template-columns: 7.5rem 1fr; column-gap: calc(var(--u) * 2); padding: calc(var(--u) * 2) 0; text-decoration: none; }
  time { padding-top: 0.3em; grid-row: span 2; }
  .t { font-weight: 700; font-size: var(--step-1); line-height: 1.3; letter-spacing: -0.01em; }
  .d { margin-top: 2px; }
  a:hover .t { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.18em; }
  @media (max-width: 560px) { a { grid-template-columns: 1fr; } time { grid-row: auto; padding: 0 0 4px; } }
</style>
