# Production: /etc/site-publisher.env (chmod 600). Local: .env in the repo root (git-ignored).
# Generate all of these with:  npm run admin:setup
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
PUBLISH_TOKEN=
GITHUB_WEBHOOK_SECRET=
GIT_SYNC=1              # commit + push posts written in the editor back to GitHub
